<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Settings</title>

    <style>
        body {
            background-color: #f4f7fa;
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
        }

        .header {
            background-color: #34495e;
            color: white;
            padding: 1.2rem;
            text-align: center;
        }

        .nav {
            display: flex;
            justify-content: center;
            margin-top: 1rem;
        }

        .nav a {
            color: #fff;
            text-decoration: none;
            padding: 0.6rem 1.2rem;
            margin: 0 0.5rem;
            border-radius: 4px;
            background-color: #2c3e50;
            transition: background-color 0.3s ease;
            font-weight: bold;
        }

        .nav a:hover {
            background-color: #1abc9c;
        }

        .container {
            max-width: 800px;
            margin: 2rem auto;
            background: #fff;
            padding: 2rem;
            border-radius: 8px;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
        }

        h1 {
            text-align: center;
            color: #2c3e50;
            margin-bottom: 2rem;
        }

        section {
            margin-bottom: 2rem;
        }

        .btn {
            display: inline-block;
            padding: 0.8rem 1.6rem;
            font-size: 1.1rem;
            color: #fff;
            background-color: #3498db;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            text-align: center;
            text-decoration: none;
            transition: background-color 0.3s ease;
        }

        .btn:hover {
            background-color: #2980b9;
        }

        .btn-danger {
            background-color: #e74c3c;
        }

        .btn-danger:hover {
            background-color: #c0392b;
        }

        .btn-success {
            background-color: #2ecc71;
        }

        .btn-success:hover {
            background-color: #27ae60;
        }

        #userActionsContainer {
            margin-top: 1rem;
        }

        .user-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.5rem;
        }
    </style>
</head>

<body>

    <!-- ===== Header Navigation ===== -->
    <div class="header">
        <h1>Admin Settings</h1>
        <div class="nav">
            <a href="/adminDashboard">Dashboard</a>
            <a href="/adminLogout">Logout</a>
        </div>
    </div>

    <!-- ===== Main Container ===== -->
    <div class="manage-account container">
        <h1>Manage Account Settings</h1>

        <section>
            <h3>Security</h3>
            <a href="/update-password" class="btn">Change Password</a>
        </section>

        <!-- ===== Activate/Deactivate Users ===== -->
        <section>
            <h3>Admin Controls</h3>
            <button id="toggleUsers" class="btn">Toggle User List</button>
            <div id="userActionsContainer"></div>
        </section>
    </div>

    <!-- ===== JavaScript ===== -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const userActionsContainer = document.getElementById('userActionsContainer');
            const toggleUsersBtn = document.getElementById('toggleUsers');

            // ===== Toggle User List =====
            toggleUsersBtn.addEventListener('click', () => {
                fetch('/api/admin/users')
                    .then(res => res.json())
                    .then(data => {
                        userActionsContainer.innerHTML = '';

                        data.users.forEach(user => {
                            if (user.isSelf) return; // Prevent self-action

                            const userDiv = document.createElement('div');
                            userDiv.classList.add('user-item');

                            userDiv.innerHTML = `
                <div>
                  <strong>${user.username}</strong> (${user.email}) -
                  <span>${user.active ? 'Active' : 'Inactive'}</span>
                </div>

                <button class="btn ${user.active ? 'btn-danger' : 'btn-success'}"
                        data-id="${user.id}"
                        data-action="${user.active ? 'deactivate' : 'activate'}">
                  ${user.active ? 'Deactivate' : 'Activate'}
                </button>
              `;

                            const btn = userDiv.querySelector('button');

                            btn.addEventListener('click', () => {
                                const id = btn.dataset.id;
                                const action = btn.dataset.action;

                                fetch(`/api/admin/users/${id}/${action}`, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' }
                                })
                                    .then(res => res.json())
                                    .then(result => {
                                        alert(result.success ? `User ${action}d successfully.` : 'Error: ' + result.message);
                                        if (result.success) toggleUsersBtn.click(); // Reload user list
                                    });
                            });

                            userActionsContainer.appendChild(userDiv);
                        });
                    });
            });
        });
    </script>
</body>

</html>