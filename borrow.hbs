<!DOCTYPE html>
<html lang="en">

<head>
    <title>Borrow Books - Library</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="/js/main.js" defer></script>
    <script src="/js/navigation.js" defer></script>
    <style>
        /* General styles */
        body {
            background-color: #fff;
            font-family: Arial, Helvetica, sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
    
        }
    
        * {
            text-decoration: none;
        }
    
        /* Sidebar (Leftbar) */
        .leftbar {
            width: 250px;
            background: #222;
            color: white;
            height: 100vh;
            padding: 20px;
            position: fixed;
            transition: all 0.3s ease-in-out;
            margin-top: 50px;
        }
    
        /* Hide sidebar on small screens */
        @media screen and (max-width: 768px) {
            .leftbar {
                width: 60px;
                overflow: hidden;
            }
    
            .leftbar a {
                text-align: center;
                font-size: 12px;
                padding: 5px;
            }
    
            .leftbar h2 {
                display: none;
            }
        }
    
        /* Main body */
        .mainbody {
            flex: 1;
            margin-left: 270px;
            padding: 20px;
            transition: margin-left 0.3s ease-in-out;
        }
    
        /* Adjust main content for smaller screens */
        @media screen and (max-width: 768px) {
            .mainbody {
                margin-left: 80px;
                padding: 10px;
            }
        }
    
        /* Navbar */
        .navbar {
            background-color: #009688;
            width: 100%;
            height: 50px;
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 0 20px;
        }
    
        .navbar button {
            background-color: #c4c4c4;
            border: none;
            border-radius: 30px;
            padding: 10px 20px;
            cursor: pointer;
            margin-right: 40px;
        }
    
        /* Sections */
        .section {
            display: none;
            width: 90%;
            max-width: 1000px;
            margin: 80px auto 20px;
            padding: 20px;
            background: white;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
    
        /* Responsive sections */
        @media screen and (max-width: 768px) {
            .section {
                width: 95%;
                padding: 15px;
            }
        }
    
        /* Book sections */
        .booksection {
            display: none;
            width: 90%;
            max-width: 800px;
            margin: 20px auto;
            padding: 20px;
            background: white;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
    
        /* Responsive book sections */
        @media screen and (max-width: 768px) {
            .booksection {
                width: 95%;
                padding: 15px;
            }
        }
    
        /* Buttons */
        button {
            margin-top: 10px;
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            background-color: #1f7429;
            color: white;
            cursor: pointer;
        }
    
        /* Responsive buttons */
        @media screen and (max-width: 768px) {
            button {
                padding: 8px 12px;
                font-size: 14px;
            }
        }
    
        /* Feedback box */
        .feedbox {
            width: 100%;
            max-width: 500px;
            height: 150px;
            margin-bottom: 20px;
        }
    
        /* Adjustments for mobile */
        @media screen and (max-width: 480px) {
            .feedbox {
                width: 90%;
                height: 120px;
            }
        }
    
        /* Links */
        .leftbar a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 10px;
            margin: 10px 0;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 5px;
            transition: background 0.3s;
        }
    
        .leftbar a:hover {
            background: rgba(255, 255, 255, 0.4);
        }
    
        /* Hide text inside links on small screens */
        @media screen and (max-width: 768px) {
            .leftbar a {
                text-align: center;
                padding: 8px;
                font-size: 12px;
            }
        }
    
        #payments {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            text-align: center;
            padding: 20px;
        }
    
        #payments .container {
            background: white;
            max-width: 400px;
            margin: 0 auto;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
        }
    
        #payments form {
            display: flex;
            flex-direction: column;
            text-align: left;
        }
    
        #payments label {
            font-weight: bold;
            margin: 10px 0 5px;
        }
    
        #payments input,
        #payments select {
            padding: 10px;
            width: 100%;
            border: 1px solid #ccc;
            border-radius: 5px;
            margin-bottom: 10px;
        }
    
        #payments button {
            background-color: #28a745;
            color: white;
            padding: 10px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }
    
        #payments button:hover {
            background-color: #218838;
        }
    
        .hidden {
            display: none;
        }
    
        #payments #confirmationMessage {
            background-color: #d4edda;
            color: #155724;
            padding: 15px;
            border-radius: 5px;
            margin-top: 20px;
            border: 1px solid #c3e6cb;
        }
    
        /* Wrapper for responsive and shadow effect */
        .table-wrapper {
            overflow-x: auto;
            background-color: #fff;
            border-radius: 6px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            margin-top: 16px;
        }
    
        .resource-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
            line-height: 1.4;
        }
    
        .resource-table thead {
            background-color: #009688;
            color: white;
        }
    
        .resource-table th,
        .resource-table td {
            padding: 8px 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }
    
    
        .resource-table tbody tr:hover {
            background-color: #f5f5f5;
        }
    
        .qty-input {
            width: 70px;
            padding: 4px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
    
    
        .reserve-btn {
            background-color: #009688;
            color: white;
            padding: 6px 10px;
            border: none;
            border-radius: 4px;
            font-size: 13px;
            cursor: pointer;
        }
    
        .reserve-btn:hover {
            background-color: #00796b;
        }
    </style>
</head>

<body>
    <div class="leftbar">
        <div class="dashboard">
            <h2>USER DASHBOARD</h2>
        </div>
        <a href="/userProfile">My Profile</a>
        <a href="/borrow" class="active">Borrow Books</a>
        <a href="/cart">My Cart</a>
        <a href="/payments">Make Payments</a>
        <a href="/return">Return Books</a>
        <a href="/history">Booking History</a>
        <a href="/reserve">Reserve Resources</a>
        <a href="/feedback">Provide Feedback</a>
        <a href="/help">Help and Support</a>
        <a href="/settings">Settings</a>
    </div>

    <div class="mainbody">
        <div class="navbar">
            <button class="logout-btn" onclick="redirectToLogout()" type="button"><span></span>LOG OUT</button>
        </div>

        <div id="borrowmaterials" class="section">
            <h2>Browse the Categories of Books</h2>

            <button onclick="showCategory('Novels')">Novels</button>
            <button onclick="showCategory('Technology')">Technology</button>
            <button onclick="showCategory('Science')">Science</button>
            <button onclick="showCategory('History')">History</button>
            <button onclick="showCategory('Health & Wellness')">Health</button>

            <div id="Novels" class="booksection">
                <h3>Novels</h3>
            </div>
            <div id="Health & Wellness" class="booksection">
                <h3>Health & Wellness</h3>
            </div>
            <div id="Technology" class="booksection">
                <h3>Technology</h3>
            </div>
            <div id="History" class="booksection">
                <h3>History</h3>
            </div>
            <div id="Science" class="booksection">
                <h3>Science</h3>
            </div>
        </div>
    </div>

    <script>
        // Make sure this script runs
        console.log("Borrow page script loaded");

        function redirectToLogout() {
            window.location.href = "/userLogout";
        }

        // Display the borrowmaterials section by default
        document.addEventListener('DOMContentLoaded', function () {
            console.log("DOM fully loaded");
            document.getElementById('borrowmaterials').style.display = "block";

            // Hide all book sections initially
            document.querySelectorAll(".booksection").forEach(section => {
                section.style.display = "none";
            });
        });

        function showCategory(category) {
            console.log("Fetching category:", category);

            fetch(`/api/books/${encodeURIComponent(category)}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! Status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log("Books API response:", data);
                    const categoryDiv = document.getElementById(category);
                    categoryDiv.innerHTML = `<h3>${category} Books</h3>`;

                    if (data.length === 0) {
                        categoryDiv.innerHTML += "<p>No books found in this category.</p>";
                    }

                    data.forEach(book => {
                        console.log("Processing book:", book);
                        const bookElement = document.createElement("p");
                        bookElement.textContent = book.title || "Untitled Book";

                        const borrowButton = document.createElement("button");
                        borrowButton.textContent = "Borrow";
                        borrowButton.style.marginRight = "10px";
                        borrowButton.onclick = function () {
                            borrowBook(book.book_id);
                        };

                        const cartButton = document.createElement("button");
                        cartButton.textContent = "Add to Cart";
                        cartButton.onclick = function () {
                            addToCart(book.book_id);
                        };

                        categoryDiv.appendChild(bookElement);
                        categoryDiv.appendChild(borrowButton);
                        categoryDiv.appendChild(cartButton);
                        categoryDiv.appendChild(document.createElement("br"));
                    });

                    // Show only the selected category
                    document.querySelectorAll(".booksection").forEach(section => {
                        section.style.display = "none";
                    });
                    categoryDiv.style.display = "block";
                })
                .catch(error => {
                    console.error("Error fetching books:", error);
                    alert("Failed to load books. Please try again later.");
                });
        }

        function borrowBook(bookId) {
            console.log("Borrowing book ID:", bookId);

            fetch("/api/books/borrow", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ book_id: bookId })
            })
                .then(response => response.json())
                .then(data => {
                    alert(data.message || "Book borrowing request submitted. It's pending admin approval.");
                })
                .catch(error => {
                    console.error("Error borrowing book:", error);
                    alert("Failed to borrow book. Please try again.");
                });
        }

        function addToCart(bookId) {
            console.log("Adding to cart book ID:", bookId);

            if (!bookId) {
                console.error("Error: bookId is null or undefined");
                alert("Error: Book ID is missing");
                return;
            }

            fetch("/api/cart/add", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ book_id: bookId, quantity: 1 })
            })
                .then(response => response.json())
                .then(data => {
                    alert(data.message || "Added to cart successfully!");
                })
                .catch(error => {
                    console.error("Error adding to cart:", error);
                    alert("Failed to add book to cart. Please try again.");
                });
        }
    </script>
</body>

</html>